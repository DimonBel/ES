@startuml Sequence Diagram - Joystick Button Press
title Sequence Diagram - Joystick Button Press & LED Control Flow

participant "FreeRTOS\nScheduler" as sched
participant "vTaskDetect\n(Priority 3)" as detect
participant "Joystick" as joy
participant "SharedData" as data
participant "BinarySemaphore" as sem
participant "vTaskDisplay\n(Priority 2)" as display
participant "LcdI2c" as lcd
participant "Mutex\n(lcdMutex)" as mutex
participant "vTaskLED\n(Priority 1)" as ledtask
participant "Led (R/G/Y)" as leds

== Initialization ==
sched -> detect : start task
sched -> display : start task
sched -> ledtask : start task

== Idle State ==
display -> lcd : "Press Joystick\nButton"

== Button Press Detection ==
loop Every 20ms
    detect -> joy : scan()
    joy --> detect : isPressed()
end

detect -> joy : scan()
joy --> detect : isPressed() = true

detect -> data : button_pressed = true
detect -> data : task_state = 1
detect -> sem : semPressDisplay.give()
detect -> sem : semPressLED.give()

== Button Pressed - Display Update ==
sem --> display : semPressDisplay.take() = true
display -> mutex : lcdMutex.take(100)
mutex --> display : true
display -> lcd : clear()
display -> lcd : print("Pressing...")
display -> lcd : print("Button")
display -> mutex : lcdMutex.give()

== Button Pressed - LED Update ==
sem --> ledtask : semPressLED.take() = true
ledtask -> leds : ledR.off()
ledtask -> leds : ledG.off()
ledtask -> leds : ledY.on()
note right of ledtask : Yellow LED ON\nwhile pressing

== Button Release Detection ==
detect -> joy : scan()
joy --> detect : isPressed() = false

detect -> joy : getPressDuration()
joy --> detect : duration (ms)
detect -> data : button_pressed = false
detect -> data : press_duration = duration
detect -> data : new_press_detected = true
detect -> data : task_state = 2
detect -> sem : semReleaseDisplay.give()
detect -> sem : semReleaseLED.give()

== Button Released - Display Update ==
sem --> display : semReleaseDisplay.take() = true
display -> mutex : lcdMutex.take(100)

alt duration > 500ms
    display -> lcd : print("Green LED:")
else duration <= 500ms
    display -> lcd : print("Red LED:")
end

display -> lcd : print(duration + " ms")
display -> mutex : lcdMutex.give()

== Button Released - LED Update ==
sem --> ledtask : semReleaseLED.take() = true
ledtask -> leds : ledY.off()
ledtask -> leds : ledR.off()
ledtask -> leds : ledG.off()

alt duration > 500ms
    ledtask -> leds : ledG.on()
    note right of ledtask : Green LED ON\n(long press)
else duration <= 500ms
    ledtask -> leds : ledR.on()
    note right of ledtask : Red LED ON\n(short press)
end

== Timeout (5 seconds) ==
display -> lcd : print("Press Joystick\nButton")
display -> data : task_state = 0
display -> data : new_press_detected = false

ledtask -> leds : all LEDs off

@enduml

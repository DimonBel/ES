{
  "version": 1,
  "author": "Lab 5.1 Variant A – ON-OFF Temperature Control",
  "editor": "wokwi",
  "parts": [
    {
      "type": "wokwi-esp32-devkit-v1",
      "id": "esp",
      "top": 80,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-dht22",
      "id": "dht",
      "top": 0,
      "left": 330,
      "attrs": { "temperature": "25", "humidity": "50" }
    },
    {
      "type": "wokwi-relay-module",
      "id": "relay",
      "top": 0,
      "left": -270,
      "attrs": {}
    },
    {
      "type": "wokwi-led",
      "id": "led",
      "top": 130,
      "left": -170,
      "attrs": { "color": "red" }
    },
    {
      "type": "wokwi-resistor",
      "id": "rled",
      "top": 130,
      "left": -110,
      "rotate": 90,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn",
      "top": 260,
      "left": 330,
      "attrs": { "color": "blue" }
    },
    {
      "type": "wokwi-lcd1602",
      "id": "lcd",
      "top": 520,
      "left": -10,
      "attrs": { "pins": "i2c", "i2cAddress": "0x27" }
    }
  ],
  "connections": [
    ["esp:GND.1", "dht:GND", "black", ["h20", "v-80"]],
    ["esp:3V3",   "dht:VCC", "red",   ["h30", "v-60"]],
    ["esp:D5",    "dht:SDA", "green", ["h40"]],

    ["esp:GND.1", "relay:GND", "black",  ["h-20", "v-100"]],
    ["esp:3V3",   "relay:VCC", "red",    ["h-30", "v-80"]],
    ["esp:D23",   "relay:IN",  "orange", ["h-40"]],

    ["esp:D2",    "rled:2",  "yellow", ["h-20"]],
    ["rled:1",    "led:A",   "yellow", ["h-10"]],
    ["esp:GND.1", "led:C",   "black",  ["h-20", "v60"]],

    ["esp:D18",   "btn:1.l", "blue",  ["h30"]],
    ["esp:GND.1", "btn:2.l", "black", ["h20", "v200"]],

    ["esp:GND.2", "lcd:GND", "black",  ["h10", "v400"]],
    ["esp:VIN",   "lcd:VCC", "red",    ["h20", "v380"]],
    ["esp:D21",   "lcd:SDA", "blue",   ["h-10", "v380"]],
    ["esp:D22",   "lcd:SCL", "purple", ["h-20", "v360"]]
  ]
}

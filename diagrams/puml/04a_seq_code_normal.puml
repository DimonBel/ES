@startuml Sequence - Normal Code Entry
title Sequence Diagram - Normal Code Entry & Verification

actor User
participant "Keypad" as kp
participant "App" as app
participant "LcdI2c" as lcd
participant "Led (Green)" as ledg
participant "Led (Red)" as ledr

== Welcome Screen ==
app -> lcd : clear()
lcd --> app : void
app -> lcd : print("Enter Code:")
lcd --> app : void
app -> lcd : print("[    ]")
lcd --> app : void

== Digit Entry ==
User -> kp : press '1'
app -> kp : getKey()
kp --> app : char: '1'
app -> lcd : setCursor(0, 1)
lcd --> app : void
app -> lcd : print("[*   ]")
lcd --> app : void

User -> kp : press '2'
app -> kp : getKey()
kp --> app : char: '2'
app -> lcd : print("[**  ]")
lcd --> app : void

User -> kp : press '3'
app -> kp : getKey()
kp --> app : char: '3'
app -> lcd : print("[*** ]")
lcd --> app : void

User -> kp : press '4'
app -> kp : getKey()
kp --> app : char: '4'
app -> lcd : print("[****]")
lcd --> app : void

== Valid Code ==
User -> kp : press '#' (ENTER)
app -> kp : getKey()
kp --> app : char: '#'
app -> app : verifyCode()
app --> app : bool: true
app -> lcd : clear()
lcd --> app : void
app -> lcd : print("ACCESS GRANTED!")
lcd --> app : void
app -> lcd : print("Door Unlocked")
lcd --> app : void
app -> ledg : on()
ledg --> app : void
app -> ledr : off()
ledr --> app : void
note right of ledg : Green ON 5 seconds
app -> ledg : off()
ledg --> app : void
app -> app : clearInput()
app --> app : void
app -> lcd : clear()
lcd --> app : void
app -> lcd : print("Enter Code:")
lcd --> app : void

== Invalid Code ==
User -> kp : press '#' (ENTER)
app -> kp : getKey()
kp --> app : char: '#'
app -> app : verifyCode()
app --> app : bool: false
app -> lcd : clear()
lcd --> app : void
app -> lcd : print("ACCESS DENIED!")
lcd --> app : void
app -> lcd : print("Wrong Code")
lcd --> app : void
app -> ledr : on()
ledr --> app : void
app -> ledg : off()
ledg --> app : void

loop 5 times (blinking)
    app -> ledr : off()
    ledr --> app : void
    app -> ledr : on()
    ledr --> app : void
end
app -> ledr : off()
ledr --> app : void
app -> app : clearInput()
app --> app : void
app -> lcd : clear()
lcd --> app : void
app -> lcd : print("Enter Code:")
lcd --> app : void

== Clear ==
User -> kp : press '*'
app -> kp : getKey()
kp --> app : char: '*'
app -> app : clearInput()
app --> app : void
app -> lcd : clear()
lcd --> app : void
app -> lcd : print("Enter Code:")
lcd --> app : void
app -> lcd : print("[    ]")
lcd --> app : void

@enduml

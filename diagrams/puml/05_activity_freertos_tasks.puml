@startuml Activity Diagram - FreeRTOS Tasks
title Activity Diagram - FreeRTOS Task Execution Flow

|#LightBlue| vTaskDetect (Priority 3) |
|#LightGreen| vTaskDisplay (Priority 2) |
|#LightYellow| vTaskLED (Priority 1) |

|vTaskDetect (Priority 3)|
start

:Initialize xLastWakeTime;

repeat
    :Wait 20ms (delayUntil);
    
    if (joystick == nullptr?) then (yes)
        :delay 100ms;
    else (no)
        :joystick->scan();
        
        if (joystick->isPressed()?) then (yes)
            if (!sharedData.button_pressed?) then (first press)
                :sharedData.button_pressed = true;
                :sharedData.task_state = 1;
                :semPressDisplay.give();
                :semPressLED.give();
                :printf("[DETECT] Button pressed");
            endif
        else (no - released)
            if (sharedData.button_pressed?) then (was pressed)
                :Get press duration;
                :sharedData.button_pressed = false;
                :sharedData.press_duration = duration;
                :sharedData.new_press_detected = true;
                :sharedData.task_state = 2;
                :semReleaseDisplay.give();
                :semReleaseLED.give();
                :printf("[DETECT] Released");
            endif
        endif
    endif
repeat while (forever)

|vTaskDisplay (Priority 2)|
start

:resultDeadline = 0;
:resultVisible = false;

repeat
    if (semPressDisplay.take(100)?) then (success)
        :updateLCD("Pressing...", "Button");
        :resultVisible = false;
    endif
    
    if (semReleaseDisplay.take(100)?) then (success)
        if (press_duration > 500ms?) then (yes)
            :line1 = "Green LED:";
        else (no)
            :line1 = "Red LED:";
        endif
        :line2 = duration + " ms";
        :updateLCD(line1, line2);
        :resultDeadline = now + 5000ms;
        :resultVisible = true;
    endif
    
    if (resultVisible AND deadline reached?) then (yes)
        :updateLCD("Press Joystick", "Button");
        :sharedData.task_state = 0;
        :resultVisible = false;
    endif
    
    :delay 50ms;
repeat while (forever)

|vTaskLED (Priority 1)|
start

repeat
    if (semPressLED.take(100)?) then (success)
        :ledR->off();
        :ledG->off();
        :ledY->on();
        note right: Yellow = pressing
    endif
    
    if (semReleaseLED.take(100)?) then (success)
        :All LEDs off;
        
        if (press_duration > 500ms?) then (yes)
            :ledG->on();
            note right: Green = long press
        else (no)
            :ledR->on();
            note right: Red = short press
        endif
    endif
    
    if (task_state == 0?) then (idle)
        :All LEDs off;
    endif
    
    :delay 50ms;
repeat while (forever)

@enduml
